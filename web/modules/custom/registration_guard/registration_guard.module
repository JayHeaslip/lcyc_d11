<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter().
 */
function registration_guard_form_user_register_form_alter(
    array &$form,
    FormStateInterface $form_state,
    $form_id
): void {
    $form['#validate'][] = 'registration_guard_validate';
}

/**
 * Reject registrations from blocked email domains and their subdomains.
 */
function registration_guard_validate(
    array &$form,
    FormStateInterface $form_state
): void {
    // Don't interfere with administrator-created accounts.
    if (\Drupal::currentUser()->hasPermission('administer users')) {
        return;
    }

    $raw_email = $form_state->getValue('mail')
        ?? $form_state->getValue(['account', 'mail'])
        ?? '';
    $email = strtolower(trim($raw_email));

    // Extract everything after the last '@' symbol.
    $at_part = strrchr($email, '@');
    if ($at_part === false) {
        return;
    }
    $host = substr($at_part, 1);

    $blocked_domains = [
        'slappergiraffe.com',
        'slappergiraffe.site',
    ];

    foreach ($blocked_domains as $domain) {
        if ($host === $domain || str_ends_with($host, '.' . $domain)) {
            \Drupal::logger('registration_guard')->warning(
                'Blocked registration attempt. Email: @email, IP: @ip',
                [
                    '@email' => $email,
                    '@ip' => \Drupal::request()->getClientIp(),
                ]
            );
            $form_state->setErrorByName(
                'mail',
                t('Registration using this email domain is not permitted.')
            );
            return;
        }
    }
}

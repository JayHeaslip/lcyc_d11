{
  "$schema": "https://biomejs.dev/schemas/1.9.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  },
  "files": { 
    "ignore": ["dist", "build", "node_modules"] 
  },
  "formatter": { 
    "enabled": true, 
    "indentStyle": "space",
      "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": { 
    "enabled": true 
  },
  "linter": {
    "enabled": true,
      "rules": {
	  "recommended": true,
	  "style": {
              "useBlockStatements": "off" 
	  },
	  "suspicious": {
              "noExplicitAny": "warn"
	  }	  
      }
  },
  "javascript": { 
    "formatter": { 
	"quoteStyle": "single",
	"semicolons": "asNeeded"
     } 
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  }
}

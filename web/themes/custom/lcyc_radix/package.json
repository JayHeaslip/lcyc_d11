{
    "name": "lcyc_radix",
    "description": "A custom Radix subtheme, based on Bootstrap 5.",
    "private": true,
    "engines": {
        "npm": ">=6.0",
        "node": ">=16.0",
        "yarn": ">=1.6"
    },
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "postinstall": "find node_modules/ -name '*.info' -type f -delete",
        "format": "biome format --write src/ components/",
        "lint": "biome lint --apply src/ components/",
        "check": "biome check --apply src/ components/",
        "fix": "biome check --write src/ components/",
        "quality": "biome check --write src/ components/"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.4.1",
        "@popperjs/core": "^2.11.8",
        "autoprefixer": "^10.4.24",
        "bootstrap": "^5.3.3",
        "dotenv": "^16.3.1",
        "drupal-radix-cli": "^1.0.6",
        "postcss": "^8.5.6",
        "postcss-scss": "^4.0.2",
        "sass": "^1.63.6",
        "sass-loader": "^13.0.2",
        "stylelint": "^14.1.0",
        "vite": "^7.3.1"
    }
}

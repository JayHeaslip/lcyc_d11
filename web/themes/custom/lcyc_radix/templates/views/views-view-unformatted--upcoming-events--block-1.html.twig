{# views-view-unformatted--upcoming-events--block-1.html.twig #}

{% if title %}
  <h3 class="block__title">{{ title }}</h3>
{% endif %}

{% set previous_group = '' %}

{% for row in rows %}

  {# Extract raw UTC string #}
  {% set raw_date = '' %}
  {% set entity = row.content['#row']._entity %}
  
  {% if entity.field_date is defined and entity.field_date[0].value is defined %}
    {% set raw_date = entity.field_date[0].value %}
  {% elseif entity.field_event_date is defined and entity.field_event_date[0].value is defined %}
    {% set raw_date = entity.field_event_date[0].value %}
  {% endif %}

  {# Force timezone conversion #}
  {% set group = '' %}
  {% if raw_date %}
    {# Append UTC explicitly and convert #}
    {% set group = (raw_date ~ ' UTC')|date('Y-m-d', 'America/New_York') %}
  {% endif %}

  {# --- DEBUG --- #}
  <div style="background: #fff8db; color: #000; padding: 10px; font-size: 11px; border: 1px solid #ddd; margin-bottom: 10px; line-height: 1.5;">
    <strong>Raw UTC:</strong> {{ raw_date }}<br>
    <strong>With UTC suffix:</strong> {{ raw_date ~ ' UTC' }}<br>
    <strong>New York Full:</strong> {{ (raw_date ~ ' UTC')|date('Y-m-d H:i:s', 'America/New_York') }}<br>
    <strong>✅ Group (Y-m-d NY):</strong> <strong style="color: blue; font-size: 13px;">{{ group }}</strong>
  </div>

  {# New day starts #}
  {% if group != previous_group and group is not empty %}
  
    {# Close previous group #}
    {% if previous_group is not empty %}
      </div> {# /.events-for-day #}
    </div> {# /.diy-event-group #}
    {% endif %}

    {# Calendar box #}
    <div class="diy-event-group">
      <div class="event-date calendar-box">
        <div class="month">{{ group|date('M')|upper }}</div>
        <div class="day">{{ group|date('j') }}</div>
        <div class="weekday">{{ group|date('D') }}</div>
      </div>
      <div class="events-for-day">
  {% endif %}

  {# Individual event with card styling #}
  <div class="event-item">
    {{ row.content }}
  </div>

  {% set previous_group = group %}
{% endfor %}

{# Close last group #}
{% if previous_group is not empty %}
    </div> {# /.events-for-day #}
  </div> {# /.diy-event-group #}
{% endif %}

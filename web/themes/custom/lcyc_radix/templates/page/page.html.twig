{#
Template for the overall page structure.
Based on a typical Bootstrap layout using Radix regions.
#}

<div id="page-wrapper">
  
  {# --- HEADER (Banner Role) --- #}
  <header role="banner" id="header" class="header px-0 py-1 container bg-custom-dark">
      {# The 'header' region typically holds the logo, site name, and perhaps search forms #}
      {{ page.header }}
  </header>
  
  {# --- Navigation Bar --- #}
  <nav role="navigation" aria-label="{{ 'Main navigation'|t }}" 
       class="navbar navbar-expand-lg navbar-dark container-fluid container-lg container bg-custom-dark-nav px-0 my-1 py-1"
       data-bs-theme="dark">
    <div class="container px-0">  
      
      {# Toggler for mobile #}
      <button class="navbar-toggler mx-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
	<span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
	<div class="navbar-nav me-auto px-0">
	  {{ page.navbar }}
	</div>
	
	{# User menu on the far right #}
	<ul class="navbar-nav ms-lg-3">
	  {% if logged_in %}
	  <li class="nav-item dropdown">
            <a href="#"
               class="nav-link dropdown-toggle text-white d-flex align-items-center"
               id="userDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
              {{ current_user_name|default('My Account') }}
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
              <li><a class="dropdown-item" href="/user">View profile</a></li>
              <li><a class="dropdown-item" href="/user/{{ user.id }}/edit">Edit profile</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/user/logout">Log out</a></li>
            </ul>
	  </li>
	{% else %}
	  {# Show login link when not logged in #}
	  <li>
	    <a href="/user/login" class="nav-link text-white">Log in</a>
	  </li>
	  {% endif %}
	</ul>
      </div>
    </div>
  </nav>
  
  {# --- Breadcrumbs --- #}
  <div class="container mt-2">
    {{ page.breadcrumb }}
  </div>
  
  <main role="main" id="main-content" class="py-2 container-fluid container-md">
      {# Use the Bootstrap row to create the two-column layout #}
      <div class="row">
	{# --- LEFT SIDE: Main Column (bigger) --- #}
	<div class="col-lg-9 col-md-8">   {# ← Changed: more space for main content #}
          {# 1a. Slideshow Region #}
          {% if page.slideshow %}
          <section id="slideshow-region" class="mb-4">
            {{ page.slideshow }}
          </section>
          {% endif %}
	  
          {# 1b. Primary Content Region #}
          {% if page.content %}
          {{ page.content }}
          {% endif %}
	</div>

	{# --- RIGHT SIDE: Sidebar Column (narrow but usable) --- #}
	<div class="col-lg-3 col-md-4">   {# ← Changed: 3 or 4 columns wide #}
          {% if page.sidebar_tall %}
          <aside class="p-3 border bg-light sticky-top" style="top: 2rem;">  {# Optional: make it sticky #}
            {{ page.sidebar_tall }}
          </aside>
          {% endif %}
	</div>
      </div>
  </main>

  {# Footer #}
  <footer role="contentinfo" id="footer" class="footer py-5 mt-4">
    <div class="container bg-custom-dark text-white text-center">
      {{ page.footer_full }}
    </div>
  </footer>
</div>
